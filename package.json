{
  "name": "cap-sample",
  "version": "1.0.0",
  "description": "Minimal CAP Node.js sample with Fiori Elements",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@cap-js/sqlite": "^3"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }
}
